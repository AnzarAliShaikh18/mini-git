{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Mini Git: build",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/build.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Mini Git: test",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/test.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Mini Git: build",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Mini Git: init",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/run.ps1",
        "-Command",
        "init"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Mini Git: build",
      "problemMatcher": []
    },
    {
      "label": "Mini Git: add",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/run.ps1",
        "-Command",
        "add",
        "-FilePath",
        "${input:filePath}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Mini Git: build",
      "problemMatcher": []
    },
    {
      "label": "Mini Git: commit",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/run.ps1",
        "-Command",
        "commit",
        "-Message",
        "${input:commitMessage}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Mini Git: build",
      "problemMatcher": []
    },
    {
      "label": "Mini Git: log",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/run.ps1",
        "-Command",
        "log"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Mini Git: build",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "filePath",
      "type": "promptString",
      "default": "hello.txt",
      "description": "File to stage (relative to project root)"
    },
    {
      "id": "commitMessage",
      "type": "promptString",
      "default": "Day 3: save staged files",
      "description": "Commit message"
    }
  ]
}
